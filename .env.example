# =================================================================
# VIRASAT Cultural Heritage Intelligence Platform — Environment Configuration
# =================================================================

# -----------------------------------------------------------------
# 1. Database Configuration
# -----------------------------------------------------------------
# Local SQLite default (zero-configuration):
DATABASE_URL=sqlite:///./virasat.db

# Docker / Production PostgreSQL:
# DATABASE_URL=postgresql://virasat_user:virasat_secure_pass@localhost:5432/virasat

# -----------------------------------------------------------------
# 2. AI Cultural Guide & LLM Provider Configuration
# -----------------------------------------------------------------
# Provider: 'gemini' (recommended) or fallback
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash

# Google Gemini API Key (Optional):
# When left empty, VIRASAT automatically activates the Grounded Database Synthesis Fallback mode,
# answering questions strictly from verified records with zero hallucination.
AI_API_KEY=

# -----------------------------------------------------------------
# 3. Backend Server & Security Configuration
# -----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated CORS allowed origins:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# -----------------------------------------------------------------
# 4. Frontend Configuration (Vite)
# -----------------------------------------------------------------
VITE_API_URL=http://127.0.0.1:8000/api

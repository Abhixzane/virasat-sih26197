{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CulturalExperience",
  "type": "object",
  "required": [
    "id",
    "name",
    "state",
    "category",
    "description",
    "informational_or_bookable",
    "verification_status"
  ],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "state": { "type": "string" },
    "city": { "type": ["string", "null"] },
    "category": { "type": "string" },
    "description": { "type": "string" },
    "cultural_significance": { "type": ["string", "null"] },
    "associated_place_id": { "type": ["string", "null"] },
    "latitude": { "type": ["number", "null"] },
    "longitude": { "type": ["number", "null"] },
    "informational_or_bookable": {
      "type": "string",
      "enum": ["INFORMATIONAL", "BOOKABLE"]
    },
    "image_url": { "type": ["string", "null"] },
    "image_attribution": { "type": ["string", "null"] },
    "license": { "type": ["string", "null"] },
    "source_url": { "type": ["string", "null"] },
    "verification_status": {
      "type": "string",
      "enum": ["VERIFIED", "PARTIALLY_VERIFIED", "UNVERIFIED", "NEEDS_REVIEW"]
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Festival",
  "type": "object",
  "required": [
    "id",
    "name",
    "slug",
    "state",
    "category",
    "cultural_significance",
    "date_type",
    "verification_status"
  ],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "slug": { "type": "string" },
    "state": { "type": "string" },
    "city": { "type": ["string", "null"] },
    "category": { "type": "string" },
    "cultural_significance": { "type": "string" },
    "traditional_period": { "type": ["string", "null"] },
    "date_type": {
      "type": "string",
      "enum": ["FIXED", "LUNAR", "ANNUAL_OFFICIAL", "APPROX_SEASONAL"]
    },
    "exact_date": { "type": ["string", "null"] },
    "date_source": { "type": ["string", "null"] },
    "rituals": { "type": ["array", "object", "null"] },
    "regional_context": { "type": ["string", "null"] },
    "image_url": { "type": ["string", "null"] },
    "image_attribution": { "type": ["string", "null"] },
    "license": { "type": ["string", "null"] },
    "source_url": { "type": ["string", "null"] },
    "verification_status": {
      "type": "string",
      "enum": ["VERIFIED", "PARTIALLY_VERIFIED", "UNVERIFIED", "NEEDS_REVIEW"]
    }
  }
}
